generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String       @id @default(uuid())
  email               String       @unique
  googleId            String       @unique
  role                UserRole     @default(USER)
  isActive            Boolean      @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  bookings            Booking[]
  customTripsCreated  CustomTrip[] @relation("CustomTripCreator")
  customTripsCustomer CustomTrip[] @relation("CustomTripCustomer")
  resolvedInquiries   Inquiry[]    @relation("InquiryResolver")
  inquiries           Inquiry[]
  profile             UserProfile?
  reviews             Review[]
  mediaUploads        MediaAsset[] @relation("MediaAssetUploader")

  @@index([email])
  @@index([role])
}

model UserProfile {
  id                       String             @id @default(uuid())
  userId                   String             @unique
  fullName                 String?
  phone                    String?
  alternatePhone           String?
  dateOfBirth              DateTime?
  gender                   Gender?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  state                    String?
  postalCode               String?
  country                  String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  bloodGroup               String?
  medicalNotes             String?
  govtIdType               GovtIdType?
  govtIdNumber             String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  govtIdImageUrl           String?
  govtIdAssetId            String?            @unique
  govtIdVerificationStatus VerificationStatus @default(UNVERIFIED)
  govtIdVerifiedAt         DateTime?
  govtIdVerifiedById       String?
  govtIdVerificationNotes  String?
  govtIdAsset              MediaAsset?        @relation("ProfileGovernmentId", fields: [govtIdAssetId], references: [id], onDelete: SetNull)
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([govtIdNumber])
}

model Trip {
  id                  String       @id @default(uuid())
  title               String
  slug                String       @unique
  location            String
  bannerImages        String[]
  duration            Int
  bestTimeToVisit     String
  overview            String
  galleryImages       String[]
  inclusions          String[]
  exclusions          String[]
  price               Decimal      @db.Decimal(10, 2)
  tokenAmount         Decimal      @db.Decimal(10, 2)
  tripType            TripType
  isActive            Boolean      @default(true)
  isFeatured          Boolean      @default(false)
  isSignature         Boolean      @default(false)
  signatureOrder      Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  destinationId       String?
  isPublished         Boolean      @default(false)
  highlights          Json         @default("[]")
  stayTransportImages Json         @default("[]")
  bookings            Booking[]
  faqs                FAQ[]
  inquiries           Inquiry[]
  itinerary           Json         @default("[]")
  packages            Package[]
  slots               Slot[]
  destination         Destination? @relation(fields: [destinationId], references: [id])
  tripTags            TripTag[]    @relation("TripToTripTag")
  reviews             Review[]
  crmLeads            CrmLead[]
  crmTasks            CrmTask[]

  @@index([tripType])
  @@index([isActive])
  @@index([isFeatured])
  @@index([isSignature, signatureOrder])
  @@index([isPublished])
  @@index([location])
  @@index([destinationId])
}

model LandingReason {
  id          String   @id @default(uuid())
  title       String
  description String
  detail      String
  imageUrl    String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model LandingTripType {
  id          String   @id @default(uuid())
  label       String
  description String
  tag         String
  imageUrl    String
  iconName    String   @default("Compass")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model LandingFootprint {
  id        String   @id @default(uuid())
  value     Float
  suffix    String   @default("")
  label     String
  sublabel  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model LandingJourneyMilestone {
  id          String   @id @default(uuid())
  period      String
  title       String
  tagline     String
  description String
  iconName    String   @default("MapPin")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model FestivalTag {
  id        String     @id @default(uuid())
  tag       String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  festivals Festival[] @relation("FestivalToFestivalTag")
}

model Festival {
  id                  String        @id @default(uuid())
  title               String
  slug                String        @unique
  location            String
  bannerImages        String[]
  videoUrl            String?
  duration            Int
  bestTimeToVisit     String
  overview            String
  highlights          Json          @default("[]")
  galleryImages       String[]
  inclusions          String[]
  exclusions          String[]
  stayTransportImages Json          @default("[]")
  price               Decimal       @db.Decimal(10, 2)
  tokenAmount         Decimal       @db.Decimal(10, 2)
  isActive            Boolean       @default(true)
  isFeatured          Boolean       @default(false)
  isPublished         Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  destinationId       String?
  bookings            Booking[]
  faqs                FAQ[]
  destination         Destination?  @relation(fields: [destinationId], references: [id])
  inquiries           Inquiry[]
  itinerary           Json          @default("[]")
  packages            Package[]
  slots               Slot[]
  tags                FestivalTag[] @relation("FestivalToFestivalTag")
  reviews             Review[]
  crmLeads            CrmLead[]
  crmTasks            CrmTask[]

  @@index([isActive])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([location])
  @@index([destinationId])
}

model Destination {
  id          String     @id @default(uuid())
  name        String
  state       String
  subheading  String?
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  festivals   Festival[]
  trips       Trip[]

  @@index([isPublished])
}

model Package {
  id          String    @id @default(uuid())
  tripId      String?
  festivalId  String?
  title       String
  price       Decimal   @db.Decimal(10, 2)
  tokenAmount Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
  festival    Festival? @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  trip        Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([festivalId])
}

model Slot {
  id          String              @id @default(uuid())
  tripId      String?
  festivalId  String?
  startDate   DateTime?
  endDate     DateTime?
  title       String?
  priority    Int                 @default(0)
  capacity    Int
  filledSpots Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  bookings    Booking[]
  festival    Festival?           @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  trip        Trip?               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  operation   DepartureOperation?
  crmTasks    CrmTask[]

  @@index([tripId])
  @@index([festivalId])
  @@index([startDate])
}

model Booking {
  id                 String             @id @default(uuid())
  bookingReference   String             @unique
  userId             String
  status             BookingStatus      @default(PENDING)
  paymentStatus      PaymentStatus      @default(PENDING)
  numberOfTravelers  Int                @default(1)
  totalAmount        Decimal            @db.Decimal(10, 2)
  tokenAmount        Decimal            @db.Decimal(10, 2)
  amountPaid         Decimal            @default(0) @db.Decimal(10, 2)
  amountDue          Decimal            @db.Decimal(10, 2)
  initialPaymentType PaymentType
  balanceDueDate     DateTime?
  reservedAt         DateTime?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  completedAt        DateTime?
  cancellationReason String?
  cancelledBy        String?
  specialRequests    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  source             BookingSource     @default(CATALOG)
  packageId          String?
  slotId             String?
  customTripId       String?           @unique
  customTripSnapshot Json?
  package            Package?          @relation(fields: [packageId], references: [id], onDelete: Restrict)
  slot               Slot?             @relation(fields: [slotId], references: [id], onDelete: Restrict)
  customTrip         CustomTrip?       @relation(fields: [customTripId], references: [id], onDelete: Restrict)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments           Payment[]
  paymentIntents     PaymentIntent[]
  reminders          PaymentReminder[]
  travelers          Traveler[]
  trip               Trip?              @relation(fields: [tripId], references: [id], onDelete: Restrict)
  tripId             String?
  festival           Festival?          @relation(fields: [festivalId], references: [id], onDelete: Restrict)
  festivalId         String?
  review             Review?
  crmLead            CrmLead?
  crmActivities      CrmActivity[]
  crmTasks           CrmTask[]
  opsCase            BookingOpsCase?
  hotelReservations  HotelReservation[]

  @@index([packageId])
  @@index([slotId])
  @@index([customTripId])
  @@index([source])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([balanceDueDate])
}

model CustomTrip {
  id                 String           @id @default(uuid())
  reference          String           @unique
  title              String
  description        String?
  customerName       String
  customerEmail      String
  customerPhone      String?
  customerUserId     String?
  createdById        String
  bannerImages       String[]         @default([])
  highlights         Json             @default("[]")
  itinerary          Json             @default("[]")
  startDate          DateTime         @db.Date
  endDate            DateTime         @db.Date
  durationDays       Int
  travelerCount      Int
  totalAmount        Decimal          @db.Decimal(10, 2)
  tokenAmount        Decimal          @db.Decimal(10, 2)
  currency           String           @default("INR")
  balanceDueDate     DateTime?        @db.Date
  validUntil         DateTime
  pricingNotes       String?
  internalNotes      String?
  status             CustomTripStatus @default(DRAFT)
  shareTokenHash     String?          @unique
  sentAt             DateTime?
  viewedAt           DateTime?
  convertedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  version            Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  customerUser       User?            @relation("CustomTripCustomer", fields: [customerUserId], references: [id], onDelete: SetNull)
  createdBy          User             @relation("CustomTripCreator", fields: [createdById], references: [id], onDelete: Restrict)
  booking            Booking?
  reviews            Review[]

  @@index([customerEmail])
  @@index([customerUserId])
  @@index([createdById])
  @@index([status])
  @@index([startDate])
  @@index([createdAt])
}

model Traveler {
  id             String      @id @default(uuid())
  bookingId      String
  fullName       String
  gender         String?
  dateOfBirth    DateTime?
  phone          String?
  aadhaar        String?
  aadhaarAssetId String?     @unique
  aadhaarAsset   MediaAsset? @relation("TravelerGovernmentId", fields: [aadhaarAssetId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  booking        Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model MediaAsset {
  id             String            @id @default(uuid())
  publicId       String            @unique
  resourceType   MediaResourceType
  deliveryType   MediaDeliveryType @default(PUBLIC)
  format         String?
  version        String?
  bytes          Int?
  width          Int?
  height         Int?
  folder         String?
  uploadedById   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  uploadedBy     User?             @relation("MediaAssetUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  profileGovtId  UserProfile?      @relation("ProfileGovernmentId")
  travelerGovtId Traveler?         @relation("TravelerGovernmentId")

  @@index([uploadedById])
  @@index([deliveryType])
}

model FAQ {
  id         String    @id @default(uuid())
  tripId     String?
  question   String
  answer     String
  order      Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  festivalId String?
  festival   Festival? @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  trip       Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([festivalId])
  @@index([order])
}

model TripTag {
  id        String   @id @default(uuid())
  tag       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trips     Trip[]   @relation("TripToTripTag")
}

model Inquiry {
  id           String    @id @default(uuid())
  name         String
  email        String
  phone        String
  tripType     TripType?
  tripId       String?
  userId       String?
  subject      String?
  message      String
  isResolved   Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedById String?
  adminNotes   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  festivalId   String?
  festival     Festival? @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  resolvedBy   User?     @relation("InquiryResolver", fields: [resolvedById], references: [id])
  trip         Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  crmLead      CrmLead?

  @@index([email])
  @@index([tripId])
  @@index([festivalId])
  @@index([userId])
  @@index([isResolved])
  @@index([createdAt])
}

model CrmContact {
  id              String        @id @default(uuid())
  userId          String?       @unique
  displayName     String
  email           String?
  normalizedEmail String?       @unique
  phone           String?
  normalizedPhone String?
  source          CrmLeadSource @default(WEBSITE)
  tags            String[]      @default([])
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  leads           CrmLead[]
  activities      CrmActivity[]
  tasks           CrmTask[]

  @@index([normalizedPhone])
  @@index([source])
  @@index([archivedAt])
  @@index([createdAt])
}

model CrmLead {
  id             String        @id @default(uuid())
  contactId      String
  inquiryId      String?       @unique
  bookingId      String?       @unique
  tripId         String?
  festivalId     String?
  tripType       TripType?
  source         CrmLeadSource @default(WEBSITE)
  stage          CrmLeadStage  @default(NEW)
  title          String?
  details        String?
  ownerId        String?
  createdById    String?
  nextFollowUpAt DateTime?
  convertedAt    DateTime?
  lostReason     String?
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  contact        CrmContact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  inquiry        Inquiry?      @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  booking        Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  trip           Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  festival       Festival?     @relation(fields: [festivalId], references: [id], onDelete: SetNull)
  activities     CrmActivity[]
  tasks          CrmTask[]

  @@index([contactId])
  @@index([stage])
  @@index([source])
  @@index([ownerId])
  @@index([nextFollowUpAt])
  @@index([archivedAt])
  @@index([createdAt])
  @@index([tripId])
  @@index([festivalId])
}

model CrmActivity {
  id          String          @id @default(uuid())
  contactId   String
  leadId      String?
  bookingId   String?
  type        CrmActivityType
  summary     String
  details     String?
  createdById String?
  createdAt   DateTime        @default(now())
  contact     CrmContact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead        CrmLead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  booking     Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([contactId, createdAt])
  @@index([leadId])
  @@index([bookingId])
  @@index([type])
  @@index([createdById])
}

model CrmTask {
  id                 String            @id @default(uuid())
  contactId          String?
  leadId             String?
  bookingId          String?
  tripId             String?
  festivalId         String?
  slotId             String?
  hotelReservationId String?
  title              String
  description        String?
  category           CrmTaskCategory   @default(GENERAL)
  priority           CrmTaskPriority   @default(MEDIUM)
  status             CrmTaskStatus     @default(OPEN)
  dueAt              DateTime?
  assigneeId         String?
  createdById        String?
  completedById      String?
  completedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  contact            CrmContact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead               CrmLead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  booking            Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  trip               Trip?             @relation(fields: [tripId], references: [id], onDelete: SetNull)
  festival           Festival?         @relation(fields: [festivalId], references: [id], onDelete: SetNull)
  slot               Slot?             @relation(fields: [slotId], references: [id], onDelete: SetNull)
  hotelReservation   HotelReservation? @relation(fields: [hotelReservationId], references: [id], onDelete: SetNull)

  @@index([contactId])
  @@index([leadId])
  @@index([bookingId])
  @@index([tripId])
  @@index([festivalId])
  @@index([slotId])
  @@index([hotelReservationId])
  @@index([category])
  @@index([status, dueAt])
  @@index([assigneeId])
  @@index([archivedAt])
}

model BookingOpsCase {
  id                          String    @id @default(uuid())
  bookingId                   String    @unique
  coordinatorId               String?
  documentsVerifiedAt         DateTime?
  documentsVerifiedById       String?
  specialRequestsReviewedAt   DateTime?
  specialRequestsReviewedById String?
  blockerReason               String?
  blockerResolvedAt           DateTime?
  blockerResolvedById         String?
  nextActionAt                DateTime?
  hotelRequired               Boolean   @default(false)
  internalNotes               String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  booking                     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([coordinatorId])
  @@index([nextActionAt])
  @@index([blockerResolvedAt])
}

model DepartureOperation {
  id                  String                   @id @default(uuid())
  slotId              String                   @unique
  status              DepartureOperationStatus @default(PLANNING)
  coordinatorId       String?
  notes               String?
  blockerReason       String?
  blockerResolvedAt   DateTime?
  blockerResolvedById String?
  nextActionAt        DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  slot                Slot                     @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([coordinatorId])
  @@index([nextActionAt])
}

model HotelReservation {
  id                 String                 @id @default(uuid())
  bookingId          String
  hotelName          String
  address            String?
  contactName        String?
  contactPhone       String?
  contactEmail       String?
  confirmationNumber String?
  roomType           String?
  roomCount          Int                    @default(1)
  guestCount         Int                    @default(1)
  checkInAt          DateTime?
  checkOutAt         DateTime?
  status             HotelReservationStatus @default(PLANNED)
  estimatedAmount    Decimal                @default(0) @db.Decimal(10, 2)
  amountPaid         Decimal                @default(0) @db.Decimal(10, 2)
  paymentStatus      VendorPaymentStatus    @default(UNPAID)
  paymentDueAt       DateTime?
  currency           String                 @default("INR")
  notes              String?
  archivedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  booking            Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tasks              CrmTask[]

  @@index([bookingId])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentDueAt])
  @@index([archivedAt])
}

model PaymentIntent {
  id              String              @id @default(uuid())
  bookingId       String
  razorpayOrderId String              @unique
  type            PaymentType
  amount          Decimal             @db.Decimal(10, 2)
  currency        String              @default("INR")
  status          PaymentIntentStatus @default(CREATED)
  expiresAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  payment         Payment?
  booking         Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}

model Payment {
  id                String                   @id @default(uuid())
  bookingId         String
  paymentIntentId   String?                  @unique
  type              PaymentType
  status            PaymentTransactionStatus @default(CREATED)
  amount            Decimal                  @db.Decimal(10, 2)
  currency          String                   @default("INR")
  razorpayOrderId   String                   @unique
  razorpayPaymentId String?                  @unique
  razorpaySignature String?
  paymentMethod     String?
  idempotencyKey    String                   @unique
  failureCode       String?
  failureReason     String?
  receiptNumber     String?                  @unique
  notes             Json?
  paidAt            DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  receiptNumberInt  Int?                     @default(autoincrement())
  booking           Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentIntent     PaymentIntent?           @relation(fields: [paymentIntentId], references: [id])
  refunds           Refund[]

  @@index([bookingId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([paidAt])
}

model PaymentWebhook {
  id              String    @id @default(uuid())
  eventId         String    @unique
  eventType       String
  payload         Json
  signature       String
  processed       Boolean   @default(false)
  processedAt     DateTime?
  processingError String?
  retryCount      Int       @default(0)
  createdAt       DateTime  @default(now())

  @@index([eventType])
  @@index([processed])
  @@index([createdAt])
}

model PaymentReminder {
  id                String         @id @default(uuid())
  bookingId         String
  type              ReminderType
  status            ReminderStatus @default(PENDING)
  sentBy            String?
  email             String
  subject           String
  sentAt            DateTime?
  providerMessageId String?
  failureReason     String?
  createdAt         DateTime       @default(now())
  booking           Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
}

model Refund {
  id               String       @id @default(uuid())
  paymentId        String
  amount           Decimal      @db.Decimal(10, 2)
  status           RefundStatus @default(PENDING)
  reason           String?
  razorpayRefundId String?      @unique
  initiatedBy      String?
  processedAt      DateTime?
  failureReason    String?
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}

enum UserRole {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum GovtIdType {
  AADHAAR
  PASSPORT
}

enum MediaResourceType {
  IMAGE
  VIDEO
  RAW
}

enum MediaDeliveryType {
  PUBLIC
  AUTHENTICATED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

