generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  googleId          String       @unique
  role              UserRole     @default(USER)
  isActive          Boolean      @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  bookings          Booking[]
  resolvedInquiries Inquiry[]    @relation("InquiryResolver")
  inquiries         Inquiry[]
  profile           UserProfile?

  @@index([email])
  @@index([role])
}

model UserProfile {
  id                       String      @id @default(uuid())
  userId                   String      @unique
  fullName                 String?
  phone                    String?
  alternatePhone           String?
  dateOfBirth              DateTime?
  gender                   Gender?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  state                    String?
  postalCode               String?
  country                  String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  bloodGroup               String?
  medicalNotes             String?
  govtIdType               GovtIdType?
  govtIdNumber             String?
  govtIdImageUrl           String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  user                     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([govtIdNumber])
}

model Trip {
  id                  String          @id @default(uuid())
  title               String
  slug                String          @unique
  location            String
  bannerImages        String[]
  duration            Int
  difficultyLevel     String
  bestTimeToVisit     String
  maxAltitude         Int
  overview            String
  highlights          Json            @default("[]")
  galleryImages       String[]
  inclusions          String[]
  exclusions          String[]
  stayTransportImages Json            @default("[]")
  price               Decimal         @db.Decimal(10, 2)
  tokenAmount         Decimal         @db.Decimal(10, 2)
  capacity            Int
  filledSpots         Int             @default(0)
  startDate           DateTime
  endDate             DateTime
  tripType            TripType
  isActive            Boolean         @default(true)
  isFeatured          Boolean         @default(false)
  isPublished         Boolean         @default(false)
  destinationId       String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  bookings            Booking[]
  faqs                FAQ[]
  inquiries           Inquiry[]
  itineraries         Itinerary[]
  tripTags            TripTag[]       @relation("TripToTripTag")
  destination         Destination?    @relation(fields: [destinationId], references: [id])

  @@index([tripType])
  @@index([startDate])
  @@index([isActive])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([location])
  @@index([destinationId])
}


model Festival {
  id                  String          @id @default(uuid())
  title               String
  slug                String          @unique
  location            String
  bannerImages        String[]
  duration            Int
  stageDays          Int
  numberOfArtists      Int
  difficultyLevel     String
  bestTimeToVisit     String
  maxAltitude         Int
  overview            String
  highlights          Json            @default("[]")
  galleryImages       String[]
  inclusions          String[]
  exclusions          String[]
  stayTransportImages Json            @default("[]")
  price               Decimal         @db.Decimal(10, 2)
  tokenAmount         Decimal         @db.Decimal(10, 2)
  capacity            Int
  filledSpots         Int             @default(0)
  startDate           DateTime
  endDate             DateTime
  isActive            Boolean         @default(true)
  isFeatured          Boolean         @default(false)
  isPublished         Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  
  @@index([startDate])
  @@index([isActive])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([location])
}

model Destination {
  id          String   @id @default(uuid())
  name        String
  state       String
  subheading  String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trips       Trip[]

  @@index([isPublished])
}

model Booking {
  id                  String                @id @default(uuid())
  bookingReference    String                @unique
  userId              String
  tripId              String
  status              BookingStatus         @default(PENDING)
  paymentStatus       PaymentStatus         @default(PENDING)
  numberOfTravelers   Int                   @default(1)
  totalAmount         Decimal               @db.Decimal(10, 2)
  tokenAmount         Decimal               @db.Decimal(10, 2)
  amountPaid          Decimal               @default(0) @db.Decimal(10, 2)
  amountDue           Decimal               @db.Decimal(10, 2)
  initialPaymentType  PaymentType
  balanceDueDate      DateTime?
  reservedAt          DateTime?
  confirmedAt         DateTime?
  cancelledAt         DateTime?
  completedAt         DateTime?
  cancellationReason  String?
  cancelledBy         String?
  specialRequests     String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  trip                Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments            Payment[]
  paymentIntents      PaymentIntent[]
  reminders           PaymentReminder[]
  travelers           Traveler[]

  
  @@index([tripId])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([balanceDueDate])
}

model Traveler {
  id          String    @id @default(uuid())
  bookingId   String
  fullName    String
  gender      String?
  dateOfBirth DateTime?
  phone       String?
  aadhaar     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Itinerary {
  id          String         @id @default(uuid())
  tripId      String?
  title       String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  trip        Trip?          @relation(fields: [tripId], references: [id])
  days        ItineraryDay[]

  @@index([tripId])
}

model ItineraryDay {
  id          String              @id @default(uuid())
  itineraryId String
  dayNumber   Int
  title       String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  activities  ItineraryActivity[]
  itinerary   Itinerary           @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@unique([itineraryId, dayNumber])
  @@index([itineraryId])
}

model ItineraryActivity {
  id             String       @id @default(uuid())
  itineraryDayId String
  title          String
  description    String?
  time           String?
  order          Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  itineraryDay   ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)

  @@index([itineraryDayId])
  @@index([order])
}

model FAQ {
  id        String   @id @default(uuid())
  tripId    String
  question  String
  answer    String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([order])
}

model TripTag {
  id        String   @id @default(uuid())
  tag       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trips     Trip[]   @relation("TripToTripTag")
}

model Inquiry {
  id           String    @id @default(uuid())
  name         String
  email        String
  phone        String
  tripType     TripType?
  tripId       String?
  userId       String?
  subject      String?
  message      String
  isResolved   Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedById String?
  adminNotes   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  resolvedBy   User?     @relation("InquiryResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  trip         Trip?     @relation(fields: [tripId], references: [id])
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([tripId])
  @@index([userId])
  @@index([isResolved])
  @@index([createdAt])
}

model PaymentIntent {
  id              String              @id @default(uuid())
  bookingId       String
  razorpayOrderId String              @unique
  type            PaymentType
  amount          Decimal             @db.Decimal(10, 2)
  currency        String              @default("INR")
  status          PaymentIntentStatus @default(CREATED)
  expiresAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  payment         Payment?
  booking         Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}

model Payment {
  id                String                   @id @default(uuid())
  bookingId         String
  paymentIntentId   String?                  @unique
  type              PaymentType
  status            PaymentTransactionStatus @default(CREATED)
  amount            Decimal                  @db.Decimal(10, 2)
  currency          String                   @default("INR")
  razorpayOrderId   String                   @unique
  razorpayPaymentId String?                  @unique
  razorpaySignature String?
  paymentMethod     String?
  idempotencyKey    String                   @unique
  failureCode       String?
  failureReason     String?
  receiptNumber     String?                  @unique
  notes             Json?
  paidAt            DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  booking           Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentIntent     PaymentIntent?           @relation(fields: [paymentIntentId], references: [id])
  refunds           Refund[]

  @@index([bookingId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([paidAt])
}

model PaymentWebhook {
  id              String    @id @default(uuid())
  eventId         String    @unique
  eventType       String
  payload         Json
  signature       String
  processed       Boolean   @default(false)
  processedAt     DateTime?
  processingError String?
  retryCount      Int       @default(0)
  createdAt       DateTime  @default(now())

  @@index([eventType])
  @@index([processed])
  @@index([createdAt])
}

model PaymentReminder {
  id                String         @id @default(uuid())
  bookingId         String
  type              ReminderType
  status            ReminderStatus @default(PENDING)
  sentBy            String?
  email             String
  subject           String
  sentAt            DateTime?
  providerMessageId String?
  failureReason     String?
  createdAt         DateTime       @default(now())
  booking           Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
}

model Refund {
  id               String       @id @default(uuid())
  paymentId        String
  amount           Decimal      @db.Decimal(10, 2)
  status           RefundStatus @default(PENDING)
  reason           String?
  razorpayRefundId String?      @unique
  initiatedBy      String?
  processedAt      DateTime?
  failureReason    String?
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}



enum UserRole {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum GovtIdType {
  AADHAAR
  PASSPORT
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum TripType {
  MOUNTAIN_TREK
  BEACH_ESCAPE
  DESERT_EXPEDITION
  JUNGLE_WILDLIFE
  HERITAGE_WALK
  ROAD_TRIP
  BACKPACKING_TOUR
  PHOTOGRAPHY_TOUR
  BONFIRE_RETREAT
  INSTITUTE_COLLEGE_TRIP
  CUSTOM_TRIP
}

enum BookingStatus {
  PENDING
  RESERVED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  FAILED
  OVERDUE
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentType {
  TOKEN
  BALANCE
  FULL
}

enum PaymentTransactionStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentIntentStatus {
  CREATED
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
}

enum ReminderType {
  MANUAL
  AUTOMATIC
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}


