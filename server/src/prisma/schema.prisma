generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// HOW THE NEW FLOW MAPS TO MODELS
// =====================================================================
// 1. Admin builds a CIRCUIT (e.g. "Tawang") = the baseline. Has days,
//    inclusions/exclusions, packages, tags, FAQs, add-ons, operational
//    task templates (hotel/transport/permit configs). NO slots.
// 2. Admin clicks "Create Trip from Circuit" -> a TRIP is forked. It
//    copies every field + CircuitDay -> TripDay + CircuitDayTask
//    templates (materialized once real Slots/dates exist). Admin only
//    has to add Slots (departure dates); everything else is editable
//    but pre-filled.
// 3. Trip can be linked to a Destination, and if isPublished=false the
//    admin can generate a shareTokenHash link for direct viewing/booking.
// 4. Every successful Payment / Refund / OperationalTask cost / AddOn
//    purchase auto-writes a LedgerEntry (income or expense) scoped to
//    that Trip. Admins can add/delete manual LedgerEntry rows too
//    (scope=OTHER for non-trip income/expense like sponsorships).
//    The "Balance Sheet" in the diagram is just LedgerEntry grouped by
//    scope + type - there's no separate BalanceSheet table needed.
// 5. Each Slot (a real departure) gets its own OperationalTask rows,
//    forked from CircuitDayTask templates, because hotel/vendor
//    arrangements differ per departure date. Status color (green/
//    yellow/red) is computed in the app from dueAt vs now + how much
//    of estimatedAmount has been arranged - not stored in the DB.
// 6. AddOns are configured on the Circuit (or directly on a Trip) and
//    purchased per Booking up until a cutoff before departure.
// 7. Booking.status -> COMPLETED triggers the review flow (Review is
//    unchanged, 1:1 with Booking); reviewRequestedAt tracks the prompt.
// =====================================================================

model User {
  id                  String       @id @default(uuid())
  email               String       @unique
  googleId            String       @unique
  role                UserRole     @default(USER)
  isActive            Boolean      @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  bookings            Booking[]
  customTripsCreated  CustomTrip[] @relation("CustomTripCreator")
  customTripsCustomer CustomTrip[] @relation("CustomTripCustomer")
  circuitsCreated     Circuit[]    @relation("CircuitCreator")
  resolvedInquiries   Inquiry[]    @relation("InquiryResolver")
  inquiries           Inquiry[]
  profile             UserProfile?
  reviews             Review[]
  mediaUploads        MediaAsset[] @relation("MediaAssetUploader")
  ledgerEntries       LedgerEntry[] @relation("LedgerEntryCreator")

  @@index([email])
  @@index([role])
}

model UserProfile {
  id                       String             @id @default(uuid())
  userId                   String             @unique
  fullName                 String?
  phone                    String?
  alternatePhone           String?
  dateOfBirth              DateTime?
  gender                   Gender?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  state                    String?
  postalCode               String?
  country                  String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  bloodGroup               String?
  medicalNotes             String?
  govtIdType               GovtIdType?
  govtIdNumber             String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  govtIdImageUrl           String?
  govtIdAssetId            String?            @unique
  govtIdAsset              MediaAsset?        @relation("ProfileGovernmentId", fields: [govtIdAssetId], references: [id], onDelete: SetNull)
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([govtIdNumber])
}


model Circuit {
  id                  String        @id @default(uuid())
  title               String
  slug                String        @unique
  tripType            TripType
  location            String
  destinationId       String?
  destination         Destination?  @relation(fields: [destinationId], references: [id])
  overview            String
  bestTimeToVisit     String
  duration            Int
  bannerImages        String[]
  galleryImages       String[]
  stayTransportImages Json          @default("[]")
  highlights          Json          @default("[]")
  inclusions          String[]
  exclusions          String[]
  basePrice           Decimal       @db.Decimal(10, 2)
  baseTokenAmount     Decimal       @db.Decimal(10, 2)
  isActive            Boolean       @default(true)
  internalNotes       String?
  createdById         String?
  createdBy           User?         @relation("CircuitCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  days                CircuitDay[]
  packages            Package[]
  faqs                FAQ[]
  tags                TripTag[]     @relation("CircuitToTripTag")
  addOns              AddOn[]
  trips               Trip[]

  @@index([tripType])
  @@index([isActive])
  @@index([destinationId])
}


model CircuitDay {
  id             String              @id @default(uuid())
  circuitId      String
  circuit        Circuit             @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  dayNumber      Int
  title          String
  description    String?
  stayLocation   String?
  properties     Json                @default("[]") // [{name, type, notes, ...}]
  visitingPlaces String[]            @default([])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tasks          CircuitDayTask[]

  @@unique([circuitId, dayNumber])
  @@index([circuitId])
}


model CircuitDayTask {
  id              String                  @id @default(uuid())
  circuitDayId    String
  circuitDay      CircuitDay              @relation(fields: [circuitDayId], references: [id], onDelete: Cascade)
  category        OperationalTaskCategory
  title           String
  description     String?
  config          Json                    @default("{}") 
  estimatedAmount Decimal?                @db.Decimal(10, 2)
  dueOffsetDays   Int?                    
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([circuitDayId])
  @@index([category])
}

model Trip {
  id                  String       @id @default(uuid())
  circuitId           String?
  circuit             Circuit?     @relation(fields: [circuitId], references: [id], onDelete: SetNull)
  title               String
  slug                String       @unique
  location            String
  bannerImages        String[]
  duration            Int
  bestTimeToVisit     String
  overview            String
  galleryImages       String[]
  inclusions          String[]
  exclusions          String[]
  price               Decimal      @db.Decimal(10, 2)
  tokenAmount         Decimal      @db.Decimal(10, 2)
  tripType            TripType
  isActive            Boolean      @default(true)
  isFeatured          Boolean      @default(false)
  isSignature         Boolean      @default(false)
  signatureOrder      Int          @default(0)
  destinationId       String?
  destination         Destination? @relation(fields: [destinationId], references: [id])
  isPublished         Boolean      @default(false)
  shareTokenHash      String?      @unique // lets an unpublished trip be viewed/booked via direct link
  shareTokenExpiresAt DateTime?
  highlights          Json         @default("[]")
  stayTransportImages Json         @default("[]")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  days                TripDay[]
  bookings            Booking[]
  faqs                FAQ[]
  inquiries           Inquiry[]
  packages            Package[]
  slots               Slot[]
  tripTags            TripTag[]    @relation("TripToTripTag")
  reviews             Review[]
  addOns              AddOn[]
  ledgerEntries       LedgerEntry[]

  @@index([tripType])
  @@index([isActive])
  @@index([isFeatured])
  @@index([isSignature, signatureOrder])
  @@index([isPublished])
  @@index([location])
  @@index([destinationId])
  @@index([circuitId])
}

model TripDay {
  id             String   @id @default(uuid())
  tripId         String
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayNumber      Int
  title          String
  description    String?
  stayLocation   String?
  properties     Json     @default("[]")
  visitingPlaces String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  operationalTasks OperationalTask[]

  @@unique([tripId, dayNumber])
  @@index([tripId])
}

model LandingReason {
  id          String   @id @default(uuid())
  title       String
  description String
  detail      String
  imageUrl    String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model LandingTripType {
  id          String   @id @default(uuid())
  label       String
  description String
  tag         String
  imageUrl    String
  iconName    String   @default("Compass")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model LandingFootprint {
  id        String   @id @default(uuid())
  value     Float
  suffix    String   @default("")
  label     String
  sublabel  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model LandingJourneyMilestone {
  id          String   @id @default(uuid())
  period      String
  title       String
  tagline     String
  description String
  iconName    String   @default("MapPin")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model FestivalTag {
  id        String     @id @default(uuid())
  tag       String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  festivals Festival[] @relation("FestivalToFestivalTag")
}


model Festival {
  id                  String        @id @default(uuid())
  title               String
  slug                String        @unique
  location            String
  bannerImages        String[]
  videoUrl            String?
  duration            Int
  bestTimeToVisit     String
  overview            String
  highlights          Json          @default("[]")
  galleryImages       String[]
  inclusions          String[]
  exclusions          String[]
  stayTransportImages Json          @default("[]")
  price               Decimal       @db.Decimal(10, 2)
  tokenAmount         Decimal       @db.Decimal(10, 2)
  isActive            Boolean       @default(true)
  isFeatured          Boolean       @default(false)
  isPublished         Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  destinationId       String?
  bookings            Booking[]
  faqs                FAQ[]
  destination         Destination?  @relation(fields: [destinationId], references: [id])
  inquiries           Inquiry[]
  itinerary           Json          @default("[]")
  packages            Package[]
  slots               Slot[]
  tags                FestivalTag[] @relation("FestivalToFestivalTag")
  reviews             Review[]
  ledgerEntries       LedgerEntry[]

  @@index([isActive])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([location])
  @@index([destinationId])
}

model Destination {
  id          String     @id @default(uuid())
  name        String
  state       String
  subheading  String?
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  festivals   Festival[]
  trips       Trip[]
  circuits    Circuit[]

  @@index([isPublished])
}

model Package {
  id          String    @id @default(uuid())
  circuitId   String?
  tripId      String?
  festivalId  String?
  title       String
  price       Decimal   @db.Decimal(10, 2)
  tokenAmount Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
  circuit     Circuit?  @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  festival    Festival? @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  trip        Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([circuitId])
  @@index([tripId])
  @@index([festivalId])
}

model Slot {
  id          String              @id @default(uuid())
  tripId      String?
  festivalId  String?
  startDate   DateTime?
  endDate     DateTime?
  title       String?
  priority    Int                 @default(0)
  capacity    Int
  filledSpots Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  bookings    Booking[]
  festival    Festival?           @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  trip        Trip?               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  operationalTasks OperationalTask[]


  @@index([tripId])
  @@index([festivalId])
  @@index([startDate])
}

model Booking {
  id                 String             @id @default(uuid())
  bookingReference   String             @unique
  userId             String
  status             BookingStatus      @default(PENDING)
  paymentStatus      PaymentStatus      @default(PENDING)
  numberOfTravelers  Int                @default(1)
  totalAmount        Decimal            @db.Decimal(10, 2)
  tokenAmount        Decimal            @db.Decimal(10, 2)
  amountPaid         Decimal            @default(0) @db.Decimal(10, 2)
  amountDue          Decimal            @db.Decimal(10, 2)
  initialPaymentType PaymentType
  balanceDueDate     DateTime?
  reservedAt         DateTime?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  completedAt        DateTime?
  reviewRequestedAt  DateTime?          // set when the post-completion review prompt is triggered
  cancellationReason String?
  cancelledBy        String?
  specialRequests    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  source             BookingSource      @default(CATALOG)
  packageId          String?
  slotId             String?
  customTripId       String?            @unique
  customTripSnapshot Json?
  package            Package?           @relation(fields: [packageId], references: [id], onDelete: Restrict)
  slot               Slot?              @relation(fields: [slotId], references: [id], onDelete: Restrict)
  customTrip         CustomTrip?        @relation(fields: [customTripId], references: [id], onDelete: Restrict)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments           Payment[]
  paymentIntents     PaymentIntent[]
  reminders          PaymentReminder[]
  travelers          Traveler[]
  trip               Trip?              @relation(fields: [tripId], references: [id], onDelete: Restrict)
  tripId             String?
  festival           Festival?          @relation(fields: [festivalId], references: [id], onDelete: Restrict)
  festivalId         String?
  review             Review?



  addOns             BookingAddOn[]
  ledgerEntries      LedgerEntry[]

  @@index([packageId])
  @@index([slotId])
  @@index([customTripId])
  @@index([source])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([balanceDueDate])
}

model CustomTrip {
  id                 String           @id @default(uuid())
  reference          String           @unique
  title              String
  description        String?
  customerName       String
  customerEmail      String
  customerPhone      String?
  customerUserId     String?
  createdById        String
  bannerImages       String[]         @default([])
  highlights         Json             @default("[]")
  itinerary          Json             @default("[]")
  startDate          DateTime         @db.Date
  endDate            DateTime         @db.Date
  durationDays       Int
  travelerCount      Int
  totalAmount        Decimal          @db.Decimal(10, 2)
  tokenAmount        Decimal          @db.Decimal(10, 2)
  currency           String           @default("INR")
  balanceDueDate     DateTime?        @db.Date
  validUntil         DateTime
  pricingNotes       String?
  internalNotes      String?
  status             CustomTripStatus @default(DRAFT)
  shareTokenHash     String?          @unique
  sentAt             DateTime?
  viewedAt           DateTime?
  convertedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  version            Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  customerUser       User?            @relation("CustomTripCustomer", fields: [customerUserId], references: [id], onDelete: SetNull)
  createdBy          User             @relation("CustomTripCreator", fields: [createdById], references: [id], onDelete: Restrict)
  booking            Booking?
  reviews            Review[]

  @@index([customerEmail])
  @@index([customerUserId])
  @@index([createdById])
  @@index([status])
  @@index([startDate])
  @@index([createdAt])
}

model Traveler {
  id             String      @id @default(uuid())
  bookingId      String
  fullName       String
  gender         String?
  dateOfBirth    DateTime?
  phone          String?
  aadhaar        String?
  aadhaarAssetId String?     @unique
  aadhaarAsset   MediaAsset? @relation("TravelerGovernmentId", fields: [aadhaarAssetId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  booking        Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model MediaAsset {
  id             String            @id @default(uuid())
  publicId       String            @unique
  resourceType   MediaResourceType
  deliveryType   MediaDeliveryType @default(PUBLIC)
  format         String?
  version        String?
  bytes          Int?
  width          Int?
  height         Int?
  folder         String?
  uploadedById   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  uploadedBy     User?             @relation("MediaAssetUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  profileGovtId  UserProfile?      @relation("ProfileGovernmentId")
  travelerGovtId Traveler?         @relation("TravelerGovernmentId")

  @@index([uploadedById])
  @@index([deliveryType])
}

model FAQ {
  id         String    @id @default(uuid())
  circuitId  String?
  tripId     String?
  festivalId String?
  question   String
  answer     String
  order      Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  circuit    Circuit?  @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  festival   Festival? @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  trip       Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([circuitId])
  @@index([tripId])
  @@index([festivalId])
  @@index([order])
}

model TripTag {
  id        String    @id @default(uuid())
  tag       String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  trips     Trip[]    @relation("TripToTripTag")
  circuits  Circuit[] @relation("CircuitToTripTag")
}

model Inquiry {
  id           String    @id @default(uuid())
  name         String
  email        String
  phone        String
  tripType     TripType?
  tripId       String?
  userId       String?
  subject      String?
  message      String
  isResolved   Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedById String?
  adminNotes   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  festivalId   String?
  festival     Festival? @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  resolvedBy   User?     @relation("InquiryResolver", fields: [resolvedById], references: [id])
  trip         Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([tripId])
  @@index([festivalId])
  @@index([userId])
  @@index([isResolved])
  @@index([createdAt])
}






model OperationalTask {
  id                  String                  @id @default(uuid())
  slotId              String
  slot                Slot                    @relation(fields: [slotId], references: [id], onDelete: Cascade)
  tripDayId           String?
  tripDay             TripDay?                @relation(fields: [tripDayId], references: [id], onDelete: SetNull)
  sourceTemplateId    String?                 // CircuitDayTask.id this was forked from, if any
  category            OperationalTaskCategory
  title               String
  description         String?
  config              Json                    @default("{}")
  estimatedAmount     Decimal                 @default(0) @db.Decimal(10, 2)
  amountArranged      Decimal                 @default(0) @db.Decimal(10, 2)
  amountPaid          Decimal                 @default(0) @db.Decimal(10, 2)
  dueAt               DateTime?
  status              OperationalTaskStatus   @default(PENDING)
  assigneeId          String?
  completedAt         DateTime?
  completedById       String?
  lastReminderSentAt  DateTime?
  reminderCount       Int                     @default(0)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  reminders           OperationalTaskReminder[]
  ledgerEntries       LedgerEntry[]

  @@index([slotId])
  @@index([tripDayId])
  @@index([category])
  @@index([status, dueAt])
  @@index([assigneeId])
}

model OperationalTaskReminder {
  id                String            @id @default(uuid())
  operationalTaskId String
  operationalTask   OperationalTask   @relation(fields: [operationalTaskId], references: [id], onDelete: Cascade)
  channel           ReminderType      @default(AUTOMATIC)
  recipientEmail    String
  subject           String
  status            ReminderStatus    @default(PENDING)
  sentAt            DateTime?
  providerMessageId String?
  failureReason     String?
  createdAt         DateTime          @default(now())

  @@index([operationalTaskId])
  @@index([status])
}

model AddOn {
  id                        String         @id @default(uuid())
  circuitId                 String?
  circuit                   Circuit?       @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  tripId                    String?
  trip                      Trip?          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  festivalId                String?
  festival                  Festival?      @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  title                     String
  description               String?
  imageUrl                  String?
  price                     Decimal        @db.Decimal(10, 2)
  maxQuantityPerBooking     Int?
  purchaseCutoffOffsetDays  Int?           
  isActive                  Boolean        @default(true)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  purchases                 BookingAddOn[]

  @@index([circuitId])
  @@index([tripId])
  @@index([festivalId])
  @@index([isActive])
}

model BookingAddOn {
  id            String             @id @default(uuid())
  bookingId     String
  booking       Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOnId       String
  addOn         AddOn              @relation(fields: [addOnId], references: [id], onDelete: Restrict)
  quantity      Int                @default(1)
  unitPrice     Decimal            @db.Decimal(10, 2)
  totalPrice    Decimal            @db.Decimal(10, 2)
  status        BookingAddOnStatus @default(PENDING)
  purchasedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  ledgerEntries LedgerEntry[]

  @@index([bookingId])
  @@index([addOnId])
  @@index([status])
}

model PaymentIntent {
  id              String              @id @default(uuid())
  bookingId       String
  razorpayOrderId String              @unique
  type            PaymentType
  amount          Decimal             @db.Decimal(10, 2)
  currency        String              @default("INR")
  status          PaymentIntentStatus @default(CREATED)
  expiresAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  payment         Payment?
  booking         Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}

model Payment {
  id                String                   @id @default(uuid())
  bookingId         String
  paymentIntentId   String?                  @unique
  type              PaymentType
  status            PaymentTransactionStatus @default(CREATED)
  amount            Decimal                  @db.Decimal(10, 2)
  currency          String                   @default("INR")
  razorpayOrderId   String                   @unique
  razorpayPaymentId String?                  @unique
  razorpaySignature String?
  paymentMethod     String?
  idempotencyKey    String                   @unique
  failureCode       String?
  failureReason     String?
  receiptNumber     String?                  @unique
  notes             Json?
  paidAt            DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  receiptNumberInt  Int?                     @default(autoincrement())
  booking           Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentIntent     PaymentIntent?           @relation(fields: [paymentIntentId], references: [id])
  refunds           Refund[]
  ledgerEntries     LedgerEntry[]

  @@index([bookingId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([paidAt])
}

model PaymentWebhook {
  id              String    @id @default(uuid())
  eventId         String    @unique
  eventType       String
  payload         Json
  signature       String
  processed       Boolean   @default(false)
  processedAt     DateTime?
  processingError String?
  retryCount      Int       @default(0)
  createdAt       DateTime  @default(now())

  @@index([eventType])
  @@index([processed])
  @@index([createdAt])
}

model PaymentReminder {
  id                String         @id @default(uuid())
  bookingId         String
  type              ReminderType
  status            ReminderStatus @default(PENDING)
  sentBy            String?
  email             String
  subject           String
  sentAt            DateTime?
  providerMessageId String?
  failureReason     String?
  createdAt         DateTime       @default(now())
  booking           Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
}

model Refund {
  id               String       @id @default(uuid())
  paymentId        String
  amount           Decimal      @db.Decimal(10, 2)
  status           RefundStatus @default(PENDING)
  reason           String?
  razorpayRefundId String?      @unique
  initiatedBy      String?
  processedAt      DateTime?
  failureReason    String?
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}

// =====================================================================
// UNIFIED LEDGER = the "Balance Sheet" from the diagram.
// Query it grouped by (scope, type) to get:
//   scope=OTHER,  type=INCOME   -> "Income Other than Trip"
//   scope=TRIP,   type=INCOME   -> "Trip Income"
//   scope=OTHER,  type=EXPENSE  -> "Expenses Other than Trip"
//   scope=TRIP,   type=EXPENSE  -> "Trip Expenses"
// Auto-generated rows (isAutoGenerated=true) come from Payments,
// Refunds, OperationalTask costs and AddOn purchases. Admins can add or
// delete manual rows (isAutoGenerated=false) from the ops dashboard.
// =====================================================================
model LedgerEntry {
  id                String              @id @default(uuid())
  type              LedgerEntryType
  scope             LedgerScope
  tripId            String?
  trip              Trip?               @relation(fields: [tripId], references: [id], onDelete: SetNull)
  festivalId        String?
  festival          Festival?           @relation(fields: [festivalId], references: [id], onDelete: SetNull)
  bookingId         String?
  booking           Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  paymentId         String?
  payment           Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  operationalTaskId String?
  operationalTask   OperationalTask?    @relation(fields: [operationalTaskId], references: [id], onDelete: SetNull)
  bookingAddOnId    String?
  bookingAddOn      BookingAddOn?       @relation(fields: [bookingAddOnId], references: [id], onDelete: SetNull)
  source            LedgerEntrySource   @default(MANUAL)
  category          String
  amount            Decimal             @db.Decimal(10, 2)
  currency          String              @default("INR")
  description       String?
  isAutoGenerated   Boolean             @default(false)
  entryDate         DateTime            @default(now())
  createdById       String?
  createdBy         User?               @relation("LedgerEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([tripId])
  @@index([festivalId])
  @@index([bookingId])
  @@index([type, scope])
  @@index([entryDate])
  @@index([source])
}

model Review {
  id           String      @id @default(uuid())
  rating       Int
  comment      String?
  userId       String
  tripId       String?
  festivalId   String?
  customTripId String?
  bookingId    String      @unique
  isPublished  Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip         Trip?       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  festival     Festival?   @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  customTrip   CustomTrip? @relation(fields: [customTripId], references: [id], onDelete: Cascade)
  booking      Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tripId])
  @@index([festivalId])
  @@index([customTripId])
  @@index([isPublished])
}



