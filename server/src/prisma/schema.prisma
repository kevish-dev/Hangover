generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  googleId          String       @unique
  role              UserRole     @default(USER)
  isActive          Boolean      @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  bookings          Booking[]
  resolvedInquiries Inquiry[]    @relation("InquiryResolver")
  inquiries         Inquiry[]
  profile           UserProfile?

  @@index([email])
  @@index([role])
}

model UserProfile {
  id                       String      @id @default(uuid())
  userId                   String      @unique
  fullName                 String?
  phone                    String?
  alternatePhone           String?
  dateOfBirth              DateTime?
  gender                   Gender?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  state                    String?
  postalCode               String?
  country                  String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  bloodGroup               String?
  medicalNotes             String?
  govtIdType               GovtIdType?
  govtIdNumber             String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  govtIdImageUrl           String?
  user                     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([govtIdNumber])
}

model Trip {
  id                  String       @id @default(uuid())
  title               String
  slug                String       @unique
  location            String
  bannerImages        String[]
  duration            Int
  bestTimeToVisit     String
  overview            String
  galleryImages       String[]
  inclusions          String[]
  exclusions          String[]
  price               Decimal      @db.Decimal(10, 2)
  tokenAmount         Decimal      @db.Decimal(10, 2)
  tripType            TripType
  isActive            Boolean      @default(true)
  isFeatured          Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  destinationId       String?
  isPublished         Boolean      @default(false)
  highlights          Json         @default("[]")
  stayTransportImages Json         @default("[]")
  bookings            Booking[]
  faqs                FAQ[]
  inquiries           Inquiry[]
  itinerary           Json         @default("[]")
  packages            Package[]
  slots               Slot[]
  destination         Destination? @relation(fields: [destinationId], references: [id])
  tripTags            TripTag[]    @relation("TripToTripTag")

  @@index([tripType])
  @@index([isActive])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([location])
  @@index([destinationId])
}

model FestivalTag {
  id        String     @id @default(uuid())
  tag       String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  festivals Festival[] @relation("FestivalToFestivalTag")
}

model Festival {
  id                  String        @id @default(uuid())
  title               String
  slug                String        @unique
  location            String
  bannerImages        String[]
  videoUrl            String?
  duration            Int
  bestTimeToVisit     String
  overview            String
  highlights          Json          @default("[]")
  galleryImages       String[]
  inclusions          String[]
  exclusions          String[]
  stayTransportImages Json          @default("[]")
  price               Decimal       @db.Decimal(10, 2)
  tokenAmount         Decimal       @db.Decimal(10, 2)
  isActive            Boolean       @default(true)
  isFeatured          Boolean       @default(false)
  isPublished         Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  destinationId       String?
  bookings            Booking[]
  faqs                FAQ[]
  destination         Destination?  @relation(fields: [destinationId], references: [id])
  inquiries           Inquiry[]
  itinerary           Json         @default("[]")
  packages            Package[]
  slots               Slot[]
  tags                FestivalTag[] @relation("FestivalToFestivalTag")

  @@index([isActive])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([location])
  @@index([destinationId])
}

model Destination {
  id          String     @id @default(uuid())
  name        String
  state       String
  subheading  String?
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  festivals   Festival[]
  trips       Trip[]

  @@index([isPublished])
}

model Package {
  id          String    @id @default(uuid())
  tripId      String?
  festivalId  String?
  title       String
  price       Decimal   @db.Decimal(10, 2)
  tokenAmount Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
  festival    Festival? @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  trip        Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([festivalId])
}

model Slot {
  id          String    @id @default(uuid())
  tripId      String?
  festivalId  String?
  startDate   DateTime?
  endDate     DateTime?
  title       String?
  priority    Int       @default(0)
  capacity    Int
  filledSpots Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
  festival    Festival? @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  trip        Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([festivalId])
  @@index([startDate])
}

model Booking {
  id                 String            @id @default(uuid())
  bookingReference   String            @unique
  userId             String
  status             BookingStatus     @default(PENDING)
  paymentStatus      PaymentStatus     @default(PENDING)
  numberOfTravelers  Int               @default(1)
  totalAmount        Decimal           @db.Decimal(10, 2)
  tokenAmount        Decimal           @db.Decimal(10, 2)
  amountPaid         Decimal           @default(0) @db.Decimal(10, 2)
  amountDue          Decimal           @db.Decimal(10, 2)
  initialPaymentType PaymentType
  balanceDueDate     DateTime?
  reservedAt         DateTime?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  completedAt        DateTime?
  cancellationReason String?
  cancelledBy        String?
  specialRequests    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  packageId          String?
  slotId             String
  package            Package?          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  slot               Slot              @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments           Payment[]
  paymentIntents     PaymentIntent[]
  reminders          PaymentReminder[]
  travelers          Traveler[]
  trip               Trip?             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId             String?
  festival           Festival?         @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  festivalId         String?

  @@index([packageId])
  @@index([slotId])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([balanceDueDate])
}

model Traveler {
  id          String    @id @default(uuid())
  bookingId   String
  fullName    String
  gender      String?
  dateOfBirth DateTime?
  phone       String?
  aadhaar     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}


model FAQ {
  id         String    @id @default(uuid())
  tripId     String?
  question   String
  answer     String
  order      Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  festivalId String?
  festival   Festival? @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  trip       Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([festivalId])
  @@index([order])
}

model TripTag {
  id        String   @id @default(uuid())
  tag       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trips     Trip[]   @relation("TripToTripTag")
}

model Inquiry {
  id           String    @id @default(uuid())
  name         String
  email        String
  phone        String
  tripType     TripType?
  tripId       String?
  userId       String?
  subject      String?
  message      String
  isResolved   Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedById String?
  adminNotes   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  festivalId   String?
  festival     Festival? @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  resolvedBy   User?     @relation("InquiryResolver", fields: [resolvedById], references: [id])
  trip         Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([tripId])
  @@index([festivalId])
  @@index([userId])
  @@index([isResolved])
  @@index([createdAt])
}

model PaymentIntent {
  id              String              @id @default(uuid())
  bookingId       String
  razorpayOrderId String              @unique
  type            PaymentType
  amount          Decimal             @db.Decimal(10, 2)
  currency        String              @default("INR")
  status          PaymentIntentStatus @default(CREATED)
  expiresAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  payment         Payment?
  booking         Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}

model Payment {
  id                String                   @id @default(uuid())
  bookingId         String
  paymentIntentId   String?                  @unique
  type              PaymentType
  status            PaymentTransactionStatus @default(CREATED)
  amount            Decimal                  @db.Decimal(10, 2)
  currency          String                   @default("INR")
  razorpayOrderId   String                   @unique
  razorpayPaymentId String?                  @unique
  razorpaySignature String?
  paymentMethod     String?
  idempotencyKey    String                   @unique
  failureCode       String?
  failureReason     String?
  receiptNumber     String?                  @unique
  notes             Json?
  paidAt            DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  receiptNumberInt  Int?                     @default(autoincrement())
  booking           Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentIntent     PaymentIntent?           @relation(fields: [paymentIntentId], references: [id])
  refunds           Refund[]

  @@index([bookingId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([paidAt])
}

model PaymentWebhook {
  id              String    @id @default(uuid())
  eventId         String    @unique
  eventType       String
  payload         Json
  signature       String
  processed       Boolean   @default(false)
  processedAt     DateTime?
  processingError String?
  retryCount      Int       @default(0)
  createdAt       DateTime  @default(now())

  @@index([eventType])
  @@index([processed])
  @@index([createdAt])
}

model PaymentReminder {
  id                String         @id @default(uuid())
  bookingId         String
  type              ReminderType
  status            ReminderStatus @default(PENDING)
  sentBy            String?
  email             String
  subject           String
  sentAt            DateTime?
  providerMessageId String?
  failureReason     String?
  createdAt         DateTime       @default(now())
  booking           Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
}

model Refund {
  id               String       @id @default(uuid())
  paymentId        String
  amount           Decimal      @db.Decimal(10, 2)
  status           RefundStatus @default(PENDING)
  reason           String?
  razorpayRefundId String?      @unique
  initiatedBy      String?
  processedAt      DateTime?
  failureReason    String?
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}

enum UserRole {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum GovtIdType {
  AADHAAR
  PASSPORT
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum TripType {
  MOUNTAIN_TREK
  BEACH_ESCAPE
  DESERT_EXPEDITION
  JUNGLE_WILDLIFE
  HERITAGE_WALK
  ROAD_TRIP
  BACKPACKING_TOUR
  PHOTOGRAPHY_TOUR
  BONFIRE_RETREAT
  INSTITUTE_COLLEGE_TRIP
  CUSTOM_TRIP
}

enum BookingStatus {
  PENDING
  RESERVED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  FAILED
  OVERDUE
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentType {
  TOKEN
  BALANCE
  FULL
}

enum PaymentTransactionStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentIntentStatus {
  CREATED
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
}

enum ReminderType {
  MANUAL
  AUTOMATIC
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}
