PORT=8080

ORIGIN=http://localhost:3000

# PostgreSQL Credentials for Docker Compose
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=hangover

# Internal Docker Compose Database Connection (points to postgres service on port 5432)
# For local PM2/host dev, use localhost:5433; inside Docker network, use postgres:5432
DATABASE_URL=postgresql://admin:password123@postgres:5432/hangover

# Docker Images (overridden dynamically by CI commit SHA on deploy)
BACKEND_IMAGE=ghcr.io/kevish-is-learning/hangover-backend:latest
MIGRATE_IMAGE=ghcr.io/kevish-is-learning/hangover-migrate:latest

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
INQUIRY_NOTIFICATION_EMAIL=

ACCESS_SECRET=
REFRESH_SECRET=
ACCESS_EXPIRY=
REFRESH_EXPIRY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
CLOUDINARY_AUTH_TOKEN_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional. Use the same value in the Vercel production environment.
SEO_INDEXNOW_KEY=
