    {
      "id": 7,
      "title": "API requests by HTTP status",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 17, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "sum by (status_code) (rate(http_requests_total{job=\"hangover-backend\",route=~\"/api/v1(/.*)?\",method!~\"OPTIONS|HEAD\"}[$__rate_interval]))", "legendFormat": "HTTP {{status_code}}", "instant": false, "range": true}
      ],
      "description": "Application requests per second. Browser preflights and HEAD probes are excluded."
    },
    {
      "id": 8,
      "title": "Successful API latency · p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 17, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"hangover-backend\",route=~\"/api/v1(/.*)?\",method!~\"OPTIONS|HEAD\",status_code=~\"2..|304\"}[15m]))) and on () (sum(increase(http_request_duration_seconds_count{job=\"hangover-backend\",route=~\"/api/v1(/.*)?\",method!~\"OPTIONS|HEAD\",status_code=~\"2..|304\"}[15m])) >= 5) and on () (max(up{job=\"hangover-backend\"}) == 1)", "legendFormat": "p50", "instant": false, "range": true},
        {"refId": "B", "datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"hangover-backend\",route=~\"/api/v1(/.*)?\",method!~\"OPTIONS|HEAD\",status_code=~\"2..|304\"}[15m]))) and on () (sum(increase(http_request_duration_seconds_count{job=\"hangover-backend\",route=~\"/api/v1(/.*)?\",method!~\"OPTIONS|HEAD\",status_code=~\"2..|304\"}[15m])) >= 20) and on () (max(up{job=\"hangover-backend\"}) == 1)", "legendFormat": "p95", "instant": false, "range": true},
        {"refId": "C", "datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"hangover-backend\",route=~\"/api/v1(/.*)?\",method!~\"OPTIONS|HEAD\",status_code=~\"2..|304\"}[15m]))) and on () (sum(increase(http_request_duration_seconds_count{job=\"hangover-backend\",route=~\"/api/v1(/.*)?\",method!~\"OPTIONS|HEAD\",status_code=~\"2..|304\"}[15m])) >= 100) and on () (max(up{job=\"hangover-backend\"}) == 1)", "legendFormat": "p99", "instant": false, "range": true}
      ],
      "description": "Rolling 15-minute latency for 2xx and 304 responses. p50, p95 and p99 appear with at least 5, 20 and 100 responses respectively."
    },
