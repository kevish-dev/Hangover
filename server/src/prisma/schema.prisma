generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  googleId          String        @unique
  role              UserRole      @default(USER)
  isActive          Boolean       @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  bookings          Booking[]
  resolvedInquiries Inquiry[]     @relation("InquiryResolver")
  inquiries         Inquiry[]
  ledgerEntries     LedgerEntry[] @relation("LedgerEntryCreator")
  mediaUploads      MediaAsset[]  @relation("MediaAssetUploader")
  reviews           Review[]
  profile           UserProfile?

  @@index([email])
  @@index([role])
}

model SiteSetting {
  id              String   @id @default("default")
  maintenanceMode Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model UserProfile {
  id                       String      @id @default(uuid())
  userId                   String      @unique
  fullName                 String?
  phone                    String?
  alternatePhone           String?
  dateOfBirth              DateTime?
  gender                   Gender?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  state                    String?
  postalCode               String?
  country                  String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  bloodGroup               String?
  medicalNotes             String?
  govtIdType               GovtIdType?
  govtIdNumber             String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  govtIdImageUrl           String?
  govtIdAssetId            String?     @unique
  govtIdAsset              MediaAsset? @relation("ProfileGovernmentId", fields: [govtIdAssetId], references: [id])
  user                     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([govtIdNumber])
}

model Trip {
  id                  String         @id @default(uuid())
  title               String
  slug                String         @unique
  location            String
  bannerImages        String[]
  duration            Int
  bestTimeToVisit     String
  overview            String
  inclusions          String[]
  exclusions          String[]
  tripType            TripType
  isActive            Boolean        @default(true)
  isFeatured          Boolean        @default(false)
  isSignature         Boolean        @default(false)
  signatureOrder      Int            @default(0)
  destinationId       String?
  isPublished         Boolean        @default(false)
  isListed            Boolean        @default(true)
  shareTokenHash      String?        @unique
  shareTokenExpiresAt DateTime?
  highlights          Json           @default("[]")
  stayTransportImages Json           @default("[]")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  addOns              AddOn[]
  bookings            Booking[]
  faqs                FAQ[]
  inquiries           Inquiry[]
  itinerary           ItineraryDay[]
  ledgerEntries       LedgerEntry[]
  packages            Package[]
  reviews             Review[]
  slots               Slot[]
  destination         Destination?   @relation(fields: [destinationId], references: [id])
  tripTags            TripTag[]      @relation("TripToTripTag")

  @@index([tripType])
  @@index([isActive])
  @@index([isFeatured])
  @@index([isSignature, signatureOrder])
  @@index([isPublished])
  @@index([location])
  @@index([destinationId])
}

model ItineraryDay {
  id               String             @id @default(uuid())
  tripId           String?
  festivalId       String?
  dayNumber        Int
  title            String
  description      String?
  todos            String[]           @default([])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  festival         Festival?          @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  trip             Trip?              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tasks            ItineraryDayTask[]
  operationalTasks OperationalTask[]

  @@unique([tripId, dayNumber])
  @@unique([festivalId, dayNumber])
  @@index([tripId])
  @@index([festivalId])
}

model ItineraryDayTask {
  id             String                  @id @default(uuid())
  itineraryDayId String
  category       OperationalTaskCategory
  title          String
  description    String?
  config         Json                    @default("{}")
  unitPrice      Decimal?                @db.Decimal(10, 2)
  quantityNeeded Int?
  dueOffsetDays  Int?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  itineraryDay   ItineraryDay            @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)

  @@index([itineraryDayId])
  @@index([category])
}

model LandingReason {
  id          String   @id @default(uuid())
  title       String
  description String
  detail      String
  imageUrl    String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model LandingTripType {
  id          String   @id @default(uuid())
  label       String
  description String
  tag         String
  imageUrl    String
  iconName    String   @default("Compass")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model LandingFootprint {
  id        String   @id @default(uuid())
  value     Float
  suffix    String   @default("")
  label     String
  sublabel  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model LandingJourneyMilestone {
  id          String   @id @default(uuid())
  period      String
  title       String
  tagline     String
  description String
  iconName    String   @default("MapPin")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model FestivalTag {
  id           String        @id @default(uuid())
  tag          String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  crmFestivals CrmFestival[] @relation("CrmFestivalToFestivalTag")
  festivals    Festival[]    @relation("FestivalToFestivalTag")
}

model Festival {
  id                  String         @id @default(uuid())
  title               String
  slug                String         @unique
  location            String
  bannerImages        String[]
  videoUrl            String?
  duration            Int
  bestTimeToVisit     String
  overview            String
  highlights          Json           @default("[]")
  inclusions          String[]
  exclusions          String[]
  stayTransportImages Json           @default("[]")
  isActive            Boolean        @default(true)
  isFeatured          Boolean        @default(false)
  isPublished         Boolean        @default(false)
  isListed            Boolean        @default(true)
  shareTokenHash      String?        @unique
  shareTokenExpiresAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  destinationId       String?
  addOns              AddOn[]
  bookings            Booking[]
  faqs                FAQ[]
  destination         Destination?   @relation(fields: [destinationId], references: [id])
  inquiries           Inquiry[]
  itinerary           ItineraryDay[]
  ledgerEntries       LedgerEntry[]
  packages            Package[]
  reviews             Review[]
  slots               Slot[]
  tags                FestivalTag[]  @relation("FestivalToFestivalTag")

  @@index([isActive])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([location])
  @@index([destinationId])
}

model Destination {
  id          String     @id @default(uuid())
  name        String
  state       String?
  subheading  String?
  description String?
  imageUrl    String?
  images      Json?      @default("[]")
  highlights  Json?      @default("[]")
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  festivals   Festival[]
  trips       Trip[]

  @@index([isPublished])
}

model CrmDestination {
  id                String             @id @default(uuid())
  name              String             @unique
  description       String?
  imageUrl          String?
  images            Json?              @default("[]")
  highlights        Json?              @default("[]")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  festivals         CrmFestival[]
  trips             CrmTrip[]
  stayLocations     StayLocation[]
  transferLocations TransferLocation[]
}

model Place {
  id                    String                         @id @default(uuid())
  stayLocationId        String
  name                  String
  description           String?
  imageUrl              String?
  images                Json?                          @default("[]")
  highlights            Json?                          @default("[]")
  isActive              Boolean                        @default(true)
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  festivalItineraryDays CrmFestivalItineraryDayPlace[]
  itineraryDays         CrmTripItineraryDayPlace[]
  stayLocation          StayLocation                   @relation(fields: [stayLocationId], references: [id])

  @@unique([stayLocationId, name])
  @@index([stayLocationId, isActive])
}

model StayLocation {
  id                    String                    @id @default(uuid())
  destinationId         String
  name                  String
  description           String?
  imageUrl              String?
  images                Json?                     @default("[]")
  highlights            Json?                     @default("[]")
  isActive              Boolean                   @default(true)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  festivalItineraryDays CrmFestivalItineraryDay[]
  itineraryDays         CrmTripItineraryDay[]
  places                Place[]
  properties            Property[]
  destination           CrmDestination            @relation(fields: [destinationId], references: [id])

  @@unique([destinationId, name])
  @@index([destinationId, isActive])
}

model Property {
  id                    String                    @id @default(uuid())
  stayLocationId        String
  name                  String
  address               String?
  description           String?
  imageUrl              String?
  images                Json?                     @default("[]")
  isActive              Boolean                   @default(true)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  festivalItineraryDays CrmFestivalItineraryDay[]
  itineraryDays         CrmTripItineraryDay[]
  stayLocation          StayLocation              @relation(fields: [stayLocationId], references: [id])

  @@unique([stayLocationId, name])
  @@index([stayLocationId, isActive])
}

model TransferLocation {
  id                  String                    @id @default(uuid())
  destinationId       String
  name                String
  description         String?
  isActive            Boolean                   @default(true)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  festivalDropOffDays CrmFestivalItineraryDay[] @relation("CrmFestivalDropOffLocation")
  dropOffDays         CrmTripItineraryDay[]     @relation("CrmDropOffLocation")
  destination         CrmDestination            @relation(fields: [destinationId], references: [id])

  @@unique([destinationId, name])
  @@index([destinationId, isActive])
}

model CrmTrip {
  id                         String                   @id @default(uuid())
  name                       String
  numberOfNights             Int
  totalAmount                Decimal?                 @db.Decimal(10, 2)
  tokenAmount                Decimal?                 @db.Decimal(10, 2)
  destinationId              String
  tripType                   TripType?
  bestTimeToVisit            String?
  isActive                   Boolean                  @default(true)
  isFeatured                 Boolean                  @default(false)
  isPublished                Boolean                  @default(false)
  isListed                   Boolean                  @default(true)
  operationsReminderDays     Int                      @default(3)
  exclusions                 String[]                 @default([])
  websiteOverview            String?
  websiteFaqs                Json                     @default("[]")
  websiteBannerImages        String[]                 @default([])
  websiteStayTransportImages Json                     @default("[]")
  websiteHighlights          Json                     @default("[]")
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  addOns                     AddOn[]
  bookings                   Booking[]
  destination                CrmDestination           @relation(fields: [destinationId], references: [id])
  commonInclusions           CrmTripCommonInclusion[]
  inclusions                 CrmTripInclusion[]
  itineraryDays              CrmTripItineraryDay[]
  slots                      CrmTripSlot[]
  ledgerEntries              LedgerEntry[]
  packages                   Package[]
  websiteTags                TripTag[]                @relation("CrmTripToTripTag")

  @@index([destinationId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([isListed])
  @@index([createdAt])
}

model CrmTripCommonInclusion {
  id           String                @id @default(uuid())
  tripId       String
  key          CrmCommonInclusionKey
  numberOfDays Int?
  isIncluded   Boolean?
  vehicleType  CrmVehicleType?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  trip         CrmTrip               @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, key])
  @@index([tripId])
}

model CrmTripItineraryDay {
  id                String                               @id @default(uuid())
  tripId            String
  dayNumber         Int
  stayLocationId    String?
  propertyId        String?
  breakfast         Boolean                              @default(false)
  lunch             Boolean                              @default(false)
  dinner            Boolean                              @default(false)
  transportEnabled  Boolean                              @default(false)
  transportText     String?
  notes             String?
  isDropOff         Boolean                              @default(false)
  dropOffLocationId String?
  createdAt         DateTime                             @default(now())
  updatedAt         DateTime                             @updatedAt
  inclusions        CrmTripInclusion[]
  dropOffLocation   TransferLocation?                    @relation("CrmDropOffLocation", fields: [dropOffLocationId], references: [id], onDelete: Restrict)
  property          Property?                            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  stayLocation      StayLocation?                        @relation(fields: [stayLocationId], references: [id], onDelete: Restrict)
  trip              CrmTrip                              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities        CrmTripItineraryDayActivity[]
  commonInclusions  CrmTripItineraryDayCommonInclusion[]
  visitingPlaces    CrmTripItineraryDayPlace[]
  operationalTasks  OperationalTask[]

  @@unique([tripId, dayNumber])
  @@index([tripId])
  @@index([stayLocationId])
  @@index([propertyId])
  @@index([dropOffLocationId])
}

model CrmTripItineraryDayCommonInclusion {
  id             String                @id @default(uuid())
  itineraryDayId String
  key            CrmCommonInclusionKey
  createdAt      DateTime              @default(now())
  itineraryDay   CrmTripItineraryDay   @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)

  @@unique([itineraryDayId, key])
  @@index([itineraryDayId])
}

model CrmTripItineraryDayPlace {
  id             String              @id @default(uuid())
  itineraryDayId String
  placeId        String
  displayOrder   Int                 @default(0)
  createdAt      DateTime            @default(now())
  itineraryDay   CrmTripItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  place          Place               @relation(fields: [placeId], references: [id])

  @@unique([itineraryDayId, placeId])
  @@index([itineraryDayId, displayOrder])
  @@index([placeId])
}

model CrmTripItineraryDayActivity {
  id             String              @id @default(uuid())
  itineraryDayId String
  name           String
  description    String?
  displayOrder   Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  itineraryDay   CrmTripItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)

  @@index([itineraryDayId, displayOrder])
}

model CrmTripInclusion {
  id             String               @id @default(uuid())
  tripId         String
  itineraryDayId String?
  type           CrmInclusionType
  sourceKey      String
  title          String
  description    String?
  displayOrder   Int                  @default(0)
  isManual       Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  itineraryDay   CrmTripItineraryDay? @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  trip           CrmTrip              @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, sourceKey])
  @@index([tripId, displayOrder])
  @@index([itineraryDayId])
  @@index([type])
}

model CrmFestival {
  id                         String                       @id @default(uuid())
  name                       String
  numberOfNights             Int
  totalAmount                Decimal?                     @db.Decimal(10, 2)
  tokenAmount                Decimal?                     @db.Decimal(10, 2)
  destinationId              String
  tripType                   TripType?
  bestTimeToVisit            String?
  isActive                   Boolean                      @default(true)
  isFeatured                 Boolean                      @default(false)
  isPublished                Boolean                      @default(false)
  isListed                   Boolean                      @default(true)
  operationsReminderDays     Int                          @default(3)
  exclusions                 String[]                     @default([])
  websiteOverview            String?
  websiteFaqs                Json                         @default("[]")
  websiteBannerImages        String[]                     @default([])
  websiteStayTransportImages Json                         @default("[]")
  websiteHighlights          Json                         @default("[]")
  websiteVideoUrl            String?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  addOns                     AddOn[]
  bookings                   Booking[]
  destination                CrmDestination               @relation(fields: [destinationId], references: [id])
  commonInclusions           CrmFestivalCommonInclusion[]
  inclusions                 CrmFestivalInclusion[]
  itineraryDays              CrmFestivalItineraryDay[]
  slots                      CrmFestivalSlot[]
  ledgerEntries              LedgerEntry[]
  packages                   Package[]
  websiteTags                FestivalTag[]                @relation("CrmFestivalToFestivalTag")

  @@index([destinationId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([isListed])
  @@index([createdAt])
}

model CrmFestivalCommonInclusion {
  id           String                @id @default(uuid())
  festivalId   String
  key          CrmCommonInclusionKey
  numberOfDays Int?
  isIncluded   Boolean?
  vehicleType  CrmVehicleType?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  festival     CrmFestival           @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  @@unique([festivalId, key])
  @@index([festivalId])
}

model CrmFestivalItineraryDay {
  id                String                                   @id @default(uuid())
  festivalId        String
  dayNumber         Int
  stayLocationId    String?
  propertyId        String?
  breakfast         Boolean                                  @default(false)
  lunch             Boolean                                  @default(false)
  dinner            Boolean                                  @default(false)
  transportEnabled  Boolean                                  @default(false)
  transportText     String?
  notes             String?
  isDropOff         Boolean                                  @default(false)
  dropOffLocationId String?
  createdAt         DateTime                                 @default(now())
  updatedAt         DateTime                                 @updatedAt
  inclusions        CrmFestivalInclusion[]
  dropOffLocation   TransferLocation?                        @relation("CrmFestivalDropOffLocation", fields: [dropOffLocationId], references: [id], onDelete: Restrict)
  festival          CrmFestival                              @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  property          Property?                                @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  stayLocation      StayLocation?                            @relation(fields: [stayLocationId], references: [id], onDelete: Restrict)
  activities        CrmFestivalItineraryDayActivity[]
  commonInclusions  CrmFestivalItineraryDayCommonInclusion[]
  visitingPlaces    CrmFestivalItineraryDayPlace[]
  operationalTasks  OperationalTask[]

  @@unique([festivalId, dayNumber])
  @@index([festivalId])
  @@index([stayLocationId])
  @@index([propertyId])
  @@index([dropOffLocationId])
}

model CrmFestivalItineraryDayCommonInclusion {
  id             String                  @id @default(uuid())
  itineraryDayId String
  key            CrmCommonInclusionKey
  createdAt      DateTime                @default(now())
  itineraryDay   CrmFestivalItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)

  @@unique([itineraryDayId, key])
  @@index([itineraryDayId])
}

model CrmFestivalItineraryDayPlace {
  id             String                  @id @default(uuid())
  itineraryDayId String
  placeId        String
  displayOrder   Int                     @default(0)
  createdAt      DateTime                @default(now())
  itineraryDay   CrmFestivalItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  place          Place                   @relation(fields: [placeId], references: [id])

  @@unique([itineraryDayId, placeId])
  @@index([itineraryDayId, displayOrder])
  @@index([placeId])
}

model CrmFestivalItineraryDayActivity {
  id             String                  @id @default(uuid())
  itineraryDayId String
  name           String
  description    String?
  displayOrder   Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  itineraryDay   CrmFestivalItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)

  @@index([itineraryDayId, displayOrder])
}

model CrmFestivalInclusion {
  id             String                   @id @default(uuid())
  festivalId     String
  itineraryDayId String?
  type           CrmInclusionType
  sourceKey      String
  title          String
  description    String?
  displayOrder   Int                      @default(0)
  isManual       Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  festival       CrmFestival              @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  itineraryDay   CrmFestivalItineraryDay? @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)

  @@unique([festivalId, sourceKey])
  @@index([festivalId, displayOrder])
  @@index([itineraryDayId])
  @@index([type])
}

model Package {
  id            String       @id @default(uuid())
  tripId        String?
  festivalId    String?
  crmTripId     String?
  crmFestivalId String?
  title         String
  price         Decimal      @db.Decimal(10, 2)
  tokenAmount   Decimal      @db.Decimal(10, 2)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  bookings      Booking[]
  crmFestival   CrmFestival? @relation(fields: [crmFestivalId], references: [id], onDelete: Cascade)
  crmTrip       CrmTrip?     @relation(fields: [crmTripId], references: [id], onDelete: Cascade)
  festival      Festival?    @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  trip          Trip?        @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([festivalId])
  @@index([crmTripId])
  @@index([crmFestivalId])
}

model Slot {
  id          String    @id @default(uuid())
  tripId      String?
  festivalId  String?
  startDate   DateTime?
  endDate     DateTime?
  title       String?
  priority    Int       @default(0)
  capacity    Int
  filledSpots Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
  festival    Festival? @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  trip        Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([festivalId])
  @@index([startDate])
}

model Booking {
  id                 String            @id @default(uuid())
  bookingReference   String            @unique
  userId             String
  status             BookingStatus     @default(PENDING)
  paymentStatus      PaymentStatus     @default(PENDING)
  numberOfTravelers  Int               @default(1)
  totalAmount        Decimal           @db.Decimal(10, 2)
  tokenAmount        Decimal           @db.Decimal(10, 2)
  amountPaid         Decimal           @default(0) @db.Decimal(10, 2)
  amountDue          Decimal           @db.Decimal(10, 2)
  initialPaymentType PaymentType
  balanceDueDate     DateTime?
  reservedAt         DateTime?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  completedAt        DateTime?
  reviewRequestedAt  DateTime?
  cancellationReason String?
  cancelledBy        String?
  specialRequests    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  source             BookingSource     @default(CATALOG)
  packageId          String?
  slotId             String?
  crmTripSlotId      String?
  crmFestivalSlotId  String?
  tripId             String?
  crmTripId          String?
  crmFestivalId      String?
  festivalId         String?
  crmFestival        CrmFestival?      @relation(fields: [crmFestivalId], references: [id], onDelete: Restrict)
  crmFestivalSlot    CrmFestivalSlot?  @relation(fields: [crmFestivalSlotId], references: [id], onDelete: Restrict)
  crmTrip            CrmTrip?          @relation(fields: [crmTripId], references: [id], onDelete: Restrict)
  crmTripSlot        CrmTripSlot?      @relation(fields: [crmTripSlotId], references: [id], onDelete: Restrict)
  festival           Festival?         @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  package            Package?          @relation(fields: [packageId], references: [id])
  slot               Slot?             @relation(fields: [slotId], references: [id])
  trip               Trip?             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  addOns             BookingAddOn[]
  ledgerEntries      LedgerEntry[]
  operationalTasks   OperationalTask[]
  payments           Payment[]
  paymentIntents     PaymentIntent[]
  reminders          PaymentReminder[]
  review             Review?
  travelers          Traveler[]

  @@index([packageId])
  @@index([slotId])
  @@index([crmTripSlotId])
  @@index([crmFestivalSlotId])
  @@index([source])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([balanceDueDate])
  @@index([crmTripId])
  @@index([crmFestivalId])
}

model Traveler {
  id             String      @id @default(uuid())
  bookingId      String
  fullName       String
  email          String?
  gender         String?
  dateOfBirth    DateTime?
  phone          String?
  aadhaar        String?
  aadhaarAssetId String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  aadhaarAsset   MediaAsset? @relation("TravelerGovernmentId", fields: [aadhaarAssetId], references: [id])
  booking        Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model MediaAsset {
  id             String            @id @default(uuid())
  publicId       String            @unique
  resourceType   MediaResourceType
  deliveryType   MediaDeliveryType @default(PUBLIC)
  format         String?
  version        String?
  bytes          Int?
  width          Int?
  height         Int?
  folder         String?
  uploadedById   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  uploadedBy     User?             @relation("MediaAssetUploader", fields: [uploadedById], references: [id])
  travelerGovtId Traveler?         @relation("TravelerGovernmentId")
  profileGovtId  UserProfile?      @relation("ProfileGovernmentId")

  @@index([uploadedById])
  @@index([deliveryType])
}

model FAQ {
  id         String    @id @default(uuid())
  tripId     String?
  festivalId String?
  question   String
  answer     String
  order      Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  festival   Festival? @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  trip       Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([festivalId])
  @@index([order])
}

model TripTag {
  id        String    @id @default(uuid())
  tag       String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  crmTrips  CrmTrip[] @relation("CrmTripToTripTag")
  trips     Trip[]    @relation("TripToTripTag")
}

model Inquiry {
  id           String    @id @default(uuid())
  name         String
  email        String
  phone        String
  tripType     TripType?
  tripId       String?
  userId       String?
  subject      String?
  message      String
  isResolved   Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedById String?
  adminNotes   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  festivalId   String?
  festival     Festival? @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  resolvedBy   User?     @relation("InquiryResolver", fields: [resolvedById], references: [id])
  trip         Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([tripId])
  @@index([festivalId])
  @@index([userId])
  @@index([isResolved])
  @@index([createdAt])
}

model OperationalTask {
  id                        String                    @id @default(uuid())
  bookingId                 String
  itineraryDayId            String?
  crmItineraryDayId         String?
  crmFestivalItineraryDayId String?
  crmSourceKey              String?
  sourceTemplateId          String?
  addOnId                   String?
  category                  OperationalTaskCategory
  title                     String
  description               String?
  config                    Json                      @default("{}")
  unitPrice                 Decimal?                  @db.Decimal(10, 2)
  quantityNeeded            Int?
  quantityAcquired          Int?
  dueAt                     DateTime?
  status                    OperationalTaskStatus     @default(PENDING)
  assigneeId                String?
  completedAt               DateTime?
  completedById             String?
  lastReminderSentAt        DateTime?
  reminderCount             Int                       @default(0)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  ledgerEntries             LedgerEntry[]
  booking                   Booking                   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  crmFestivalItineraryDay   CrmFestivalItineraryDay?  @relation(fields: [crmFestivalItineraryDayId], references: [id])
  crmItineraryDay           CrmTripItineraryDay?      @relation(fields: [crmItineraryDayId], references: [id])
  itineraryDay              ItineraryDay?             @relation(fields: [itineraryDayId], references: [id])
  reminders                 OperationalTaskReminder[]

  @@index([bookingId])
  @@index([itineraryDayId])
  @@index([crmItineraryDayId])
  @@index([crmFestivalItineraryDayId])
  @@index([category])
  @@index([status, dueAt])
  @@index([assigneeId])
}

model OperationalTaskReminder {
  id                String          @id @default(uuid())
  operationalTaskId String
  channel           ReminderType    @default(AUTOMATIC)
  recipientEmail    String
  subject           String
  status            ReminderStatus  @default(PENDING)
  sentAt            DateTime?
  providerMessageId String?
  failureReason     String?
  createdAt         DateTime        @default(now())
  operationalTask   OperationalTask @relation(fields: [operationalTaskId], references: [id], onDelete: Cascade)

  @@index([operationalTaskId])
  @@index([status])
}

model AddOn {
  id                       String         @id @default(uuid())
  tripId                   String?
  festivalId               String?
  crmTripId                String?
  crmFestivalId            String?
  title                    String
  description              String?
  imageUrl                 String?
  price                    Decimal        @db.Decimal(10, 2)
  maxQuantityPerBooking    Int?
  maxQuantityPerSlot       Int?
  purchaseCutoffOffsetDays Int?
  isActive                 Boolean        @default(true)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  crmFestival              CrmFestival?   @relation(fields: [crmFestivalId], references: [id], onDelete: Cascade)
  crmTrip                  CrmTrip?       @relation(fields: [crmTripId], references: [id], onDelete: Cascade)
  festival                 Festival?      @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  trip                     Trip?          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  purchases                BookingAddOn[]

  @@index([tripId])
  @@index([festivalId])
  @@index([crmTripId])
  @@index([crmFestivalId])
  @@index([isActive])
}

model BookingAddOn {
  id            String             @id @default(uuid())
  bookingId     String
  addOnId       String?
  quantity      Int                @default(1)
  unitPrice     Decimal            @db.Decimal(10, 2)
  totalPrice    Decimal            @db.Decimal(10, 2)
  status        BookingAddOnStatus @default(PENDING)
  purchasedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  addOn         AddOn?             @relation(fields: [addOnId], references: [id])
  booking       Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@index([bookingId])
  @@index([addOnId])
  @@index([status])
}

model PaymentIntent {
  id              String              @id @default(uuid())
  bookingId       String
  razorpayOrderId String              @unique
  type            PaymentType
  amount          Decimal             @db.Decimal(10, 2)
  currency        String              @default("INR")
  status          PaymentIntentStatus @default(CREATED)
  expiresAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  payment         Payment?
  booking         Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}

model Payment {
  id                String                   @id @default(uuid())
  bookingId         String
  paymentIntentId   String?                  @unique
  type              PaymentType
  status            PaymentTransactionStatus @default(CREATED)
  amount            Decimal                  @db.Decimal(10, 2)
  currency          String                   @default("INR")
  razorpayOrderId   String                   @unique
  razorpayPaymentId String?                  @unique
  razorpaySignature String?
  paymentMethod     String?
  utr               String?
  idempotencyKey    String                   @unique
  failureCode       String?
  failureReason     String?
  receiptNumber     String?                  @unique
  notes             Json?
  paidAt            DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  receiptNumberInt  Int                      @default(autoincrement())
  ledgerEntries     LedgerEntry[]
  booking           Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentIntent     PaymentIntent?           @relation(fields: [paymentIntentId], references: [id])
  refunds           Refund[]

  @@index([bookingId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([paidAt])
}

model PaymentWebhook {
  id              String    @id @default(uuid())
  eventId         String    @unique
  eventType       String
  payload         Json
  signature       String
  processed       Boolean   @default(false)
  processedAt     DateTime?
  processingError String?
  retryCount      Int       @default(0)
  createdAt       DateTime  @default(now())

  @@index([eventType])
  @@index([processed])
  @@index([createdAt])
}

model PaymentReminder {
  id                String         @id @default(uuid())
  bookingId         String
  type              ReminderType
  status            ReminderStatus @default(PENDING)
  sentBy            String?
  email             String
  subject           String
  sentAt            DateTime?
  providerMessageId String?
  failureReason     String?
  createdAt         DateTime       @default(now())
  booking           Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
}

model Refund {
  id               String       @id @default(uuid())
  paymentId        String
  amount           Decimal      @db.Decimal(10, 2)
  status           RefundStatus @default(PENDING)
  reason           String?
  razorpayRefundId String?      @unique
  initiatedBy      String?
  processedAt      DateTime?
  failureReason    String?
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}

model LedgerEntry {
  id                String            @id @default(uuid())
  type              LedgerEntryType
  scope             LedgerScope
  tripId            String?
  festivalId        String?
  crmTripId         String?
  crmFestivalId     String?
  bookingId         String?
  paymentId         String?
  operationalTaskId String?
  bookingAddOnId    String?
  source            LedgerEntrySource @default(MANUAL)
  category          String
  amount            Decimal           @db.Decimal(10, 2)
  currency          String            @default("INR")
  description       String?
  isAutoGenerated   Boolean           @default(false)
  entryDate         DateTime          @default(now())
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  bookingAddOn      BookingAddOn?     @relation(fields: [bookingAddOnId], references: [id])
  booking           Booking?          @relation(fields: [bookingId], references: [id])
  createdBy         User?             @relation("LedgerEntryCreator", fields: [createdById], references: [id])
  crmFestival       CrmFestival?      @relation(fields: [crmFestivalId], references: [id])
  crmTrip           CrmTrip?          @relation(fields: [crmTripId], references: [id])
  festival          Festival?         @relation(fields: [festivalId], references: [id])
  operationalTask   OperationalTask?  @relation(fields: [operationalTaskId], references: [id])
  payment           Payment?          @relation(fields: [paymentId], references: [id])
  trip              Trip?             @relation(fields: [tripId], references: [id])

  @@index([tripId])
  @@index([festivalId])
  @@index([crmTripId])
  @@index([crmFestivalId])
  @@index([bookingId])
  @@index([type, scope])
  @@index([entryDate])
  @@index([source])
}

model Review {
  id          String    @id @default(uuid())
  rating      Int
  comment     String?
  userId      String
  tripId      String?
  festivalId  String?
  bookingId   String    @unique
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  festival    Festival? @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  trip        Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tripId])
  @@index([festivalId])
  @@index([isPublished])
}

model CustomInvoice {
  id            String        @id @default(uuid())
  customerName  String
  customerEmail String
  customerPhone String?
  title         String
  description   String?
  items         Json          @default("[]")
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("INR")
  dueDate       DateTime?
  status        InvoiceStatus @default(SENT)
  source        InvoiceSource @default(CUSTOM)
  bookingId     String?
  paymentId     String?       @unique
  sentAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([source])
  @@index([bookingId])
  @@index([customerEmail])
}

model CrmTripSlot {
  id          String    @id @default(uuid())
  crmTripId   String
  startDate   DateTime?
  endDate     DateTime?
  title       String?
  priority    Int       @default(0)
  capacity    Int
  filledSpots Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
  crmTrip     CrmTrip   @relation(fields: [crmTripId], references: [id], onDelete: Cascade)

  @@index([crmTripId])
  @@index([startDate])
}

model CrmFestivalSlot {
  id            String      @id @default(uuid())
  crmFestivalId String
  startDate     DateTime?
  endDate       DateTime?
  title         String?
  priority      Int         @default(0)
  capacity      Int
  filledSpots   Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  bookings      Booking[]
  crmFestival   CrmFestival @relation(fields: [crmFestivalId], references: [id], onDelete: Cascade)

  @@index([crmFestivalId])
  @@index([startDate])
}

